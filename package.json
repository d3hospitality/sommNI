{
  "name": "sommni",
  "version": "1.0.0",
  "description": "wineLENS — tasting notes, your Winebrary and the Wine Atlas, on the phone and Even Realities G2",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:ui": "node tests/winebrary.browser.cjs",
    "test:list": "node tests/wine-list.browser.cjs",
    "test:glasses": "node tests/winebrary.glasses.cjs",
    "test:nav": "node tests/glasses.navigation.cjs && node tests/catalog-lifecycle.cjs",
    "test:display": "node tests/no-mascot.cjs",
    "test:bottles": "node tests/catalog-bottles.cjs",
    "test:study": "node tests/study.engine.cjs && node tests/study.glasses.cjs && node tests/study.phone.cjs",
    "check:ids": "node --experimental-strip-types --no-warnings scripts/assign-canonical-ids.mjs",
    "pack:beta": "sh scripts/pack-beta.sh",
    "dev:site": "vite --config vite.site.config.ts --host 127.0.0.1 --port 5187",
    "build:site": "vite build --config vite.site.config.ts",
    "typecheck:site": "tsc --noEmit -p tsconfig.site.json",
    "test:accounts": "node --test tests/device-link.test.cjs",
    "test:link": "node tests/device-link.browser.cjs",
    "test:site": "node tests/site.browser.cjs",
    "render:showcase": "node tools/render-showcase.cjs",
    "test:sql": "node tests/sql/run.cjs",
    "test:pairing": "node tests/pairing.e2e.cjs",
    "test:billing": "node --test tests/billing.test.cjs",
    "test:scan": "node --test tests/wine-scan.test.cjs",
    "test:sql:embedded": "node tests/sql/embedded.mjs",
    "test:sql:api": "node tests/sql/api.mjs",
    "test:api": "node --test tests/winebrary-api.test.cjs tests/wine-identity.test.cjs tests/wine-list.test.cjs tests/catalog-review.test.cjs"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.9",
    "@supabase/supabase-js": "2.117.2",
    "openai": "^6.22.0",
    "stripe": "22.6.2",
    "three": "0.180.0",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/three": "0.180.0",
    "gh-pages": "^6.3.0",
    "playwright": "1.62.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
